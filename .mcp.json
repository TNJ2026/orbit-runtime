{
  "mcpServers": {
    "promptaflow": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        ".",
        "orbit",
        "agent-app",
        "mcp-proxy"
      ],
      "cwd": ".",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "env_vars": [
        "HOME",
        "USERPROFILE",
        "HOMEDRIVE",
        "HOMEPATH",
        "APPDATA",
        "LOCALAPPDATA",
        "PATH",
        "PATHEXT",
        "COMSPEC",
        "USERNAME",
        "ORBIT_AGENT_APP_WORKSPACE",
        "ORBIT_CLI",
        "SYSTEMROOT",
        "WINDIR",
        "TEMP",
        "TMP"
      ]
    }
  }
}
