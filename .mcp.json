{
  "mcpServers": {
    "orbit": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./start-orbit.cmd",
        "-McpProxy"
      ],
      "cwd": ".",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "env_vars": [
        "HOME",
        "USERPROFILE",
        "HOMEDRIVE",
        "HOMEPATH",
        "APPDATA",
        "LOCALAPPDATA",
        "PATH",
        "PATHEXT",
        "COMSPEC",
        "USERNAME",
        "ORBIT_AGENT_APP_WORKSPACE",
        "ORBIT_CLI",
        "SYSTEMROOT",
        "WINDIR",
        "TEMP",
        "TMP"
      ]
    }
  }
}
