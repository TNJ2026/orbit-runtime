{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@orbit-runtime/integration-core": [
        "../../integration-core/lib/index.d.ts"
      ]
    },
    "strict": true,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/client"
  ]
}
